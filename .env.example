# Copia questo file in ".env" e inserisci la tua chiave.
# Come ottenerla: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# (Opzionale) Lingua dei dati TMDB. Default: it-IT
TMDB_LANGUAGE=it-IT

# (Opzionale) Regione usata per "dove vederla" (servizi di streaming).
# Codice paese ISO 3166-1 a due lettere. Default: IT
TMDB_REGION=IT

# Fumetti occidentali (Comic Vine). Chiave gratuita:
#  1) registrati su https://comicvine.gamespot.com
#  2) apri https://comicvine.gamespot.com/api/ e copia la tua API key
COMICVINE_API_KEY=

# (Opzionale) Libri (Google Books): alza le quote. Lascia vuoto per usarla senza chiave.
GOOGLE_BOOKS_API_KEY=

# Nota: anime e manga usano Jikan (MyAnimeList) che non richiede alcuna chiave.
